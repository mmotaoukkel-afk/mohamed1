{
    "cli": {
        "version": ">= 5.9.3",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "credentialsSource": "remote"
        },
        "preview": {
            "distribution": "internal"
        },
        "production": {
            "android": {
                "buildType": "app-bundle",
                "image": "latest",
                "resourceClass": "medium"
            },
            "env": {
                "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx3072m -XX:MaxMetaspaceSize=512m"
            }
        }
    },
    "submit": {
        "production": {}
    }
}